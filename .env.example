# Copy this file to .env for local Docker Compose development.
# Do NOT commit .env — it is gitignored.

# --- PostgreSQL ---
POSTGRES_DB=products
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
# asyncpg URL used inside Docker (service name "postgres" resolves via Docker DNS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/products
REDIS_URL=redis://redis:6379/0
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
UPLOAD_DIR=/tmp/product-imports

# --- Ports (host side) ---
API_HOST_PORT=8010
FRONTEND_HOST_PORT=3000

# --- Frontend ---
# Must match API_HOST_PORT when running locally
NEXT_PUBLIC_API_URL=http://localhost:8010
